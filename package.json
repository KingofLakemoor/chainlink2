    "@stripe/stripe-js": "^9.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.23",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ogl": "^1.0.11",
    "puppeteer": "^24.43.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "react-router": "^7.17.0",
    "react-router-dom": "^7.17.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.22.4"
