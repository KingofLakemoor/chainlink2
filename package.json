{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/functions.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --target=node22 --outfile=dist/server.cjs --bundle --format=cjs --packages=external && esbuild functions.ts --platform=node --target=node22 --outfile=dist/functions.cjs --bundle --format=cjs --packages=external",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "init-db": "tsx scripts/init_collections.ts",
    "seed-achievements": "tsx scripts/seed_achievements.ts",
    "seed-shop": "tsx scripts/seed_shop.ts",
    "seed-shop:new": "tsx scripts/seed_shop.ts --new-only",
    "seed-shop:changed": "tsx scripts/seed_shop.ts --changed-only",
    "seed-shop:force": "tsx scripts/seed_shop.ts --force"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-label": "^2.1.8",
