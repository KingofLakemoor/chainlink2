    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-icons": "^2.2.7",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "firebase-tools": "^15.20.0",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
