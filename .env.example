# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_FIREBASE_API_KEY: Required for Firebase Authentication.
# Provides the API key for initializing the Firebase client app.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"

# VITE_FIREBASE_VAPID_KEY: Required for Firebase Cloud Messaging (Web Push Notifications).
# Generate this in Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY="MY_FIREBASE_VAPID_KEY"

# VITE_STRIPE_PUBLISHABLE_KEY: Required for Stripe payments on the frontend.
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_123"

# STRIPE_SECRET_KEY: Required for Stripe API calls on the backend.
STRIPE_SECRET_KEY="sk_test_123"

# STRIPE_WEBHOOK_SECRET: Required for verifying Stripe webhooks on the backend.
STRIPE_WEBHOOK_SECRET="whsec_123"

GOOGLE_APPLICATION_CREDENTIALS="path/to/your/firebase-adminsdk.json"

# FIREBASE_SERVICE_ACCOUNT_KEY: (Optional) Used for authenticating the Firebase Admin SDK
# outside of Google Cloud Run (e.g. local machine, VPS). Paste the entire JSON
# content of your service account key file here as a single string.
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'
